# ==========================================================================
# AI Shorts Maker - backend environment variables
# Copy to .env and fill in. Every value has a safe local default.
# ==========================================================================

# --- AI: highlight selection (Gemini) ---
# Without a key the pipeline still runs using the heuristic highlight selector.
GEMINI_API_KEY=
# gemini-flash-latest tracks the current stable Flash model (avoids the
# "no longer available to new users" 404 on pinned older versions).
GEMINI_MODEL=gemini-flash-latest

# --- AI: transcription (faster-whisper) ---
# Transcription is the slow step on CPU. Speed levers below.
ENABLE_TRANSCRIPTION=true     # set false to skip captions and render fast
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1          # 1 = fastest (greedy); 5 = default, slower
WHISPER_CPU_THREADS=0        # 0 = auto (use all cores)
MAX_TRANSCRIBE_SECONDS=0     # 0 = whole video; e.g. 900 caps at first 15 min
WHISPER_VAD=true             # skip silence/music; set false if timing feels off

# --- Edited-look effects (TikTok / Minecraft Shorts style) ---
ENHANCED_EDIT=true           # master switch for all effects below
ANIMATED_CAPTIONS=true       # animated phrase captions with pop/overshoot
ENABLE_ZOOM=true             # subtle punch-in / slow zoom
ZOOM_MAX=1.12                # 1.0 = off; 1.12 = gentle; 1.25 = strong
ENABLE_COLOR_GRADE=true
COLOR_CONTRAST=1.08
COLOR_SATURATION=1.20
# Background music: point at an mp3/wav. Skipped if the file is missing/empty.
BACKGROUND_MUSIC=background.mp3
BG_MUSIC_VOLUME=0.12

# --- Caption style (engine: services/caption_style.py) ---
CAPTION_STYLE=minecraft      # minecraft | gaming | minimal
# Optional overrides (leave blank to use the preset's value):
CAPTION_FONT=                # e.g. Arial, Impact, Montserrat (must be installed)
CAPTION_FONT_SIZE=           # e.g. 84
CAPTION_COLOR=               # ASS &HAABBGGRR, e.g. &H00FFFFFF (white)
CAPTION_OUTLINE_COLOR=       # e.g. &H00000000 (black)
CAPTION_OUTLINE_WIDTH=       # e.g. 6
CAPTION_SHADOW=              # e.g. 2.5
CAPTION_MARGIN_V=            # distance from bottom; higher = further up (e.g. 900)
CAPTION_MAX_WORDS=           # words per phrase, e.g. 4
CAPTION_HIGHLIGHT_COLOR=     # emphasis colour, e.g. &H0000FFFF (yellow), &H00FFFF00 (cyan)
# Sync nudge (ms). Negative = captions EARLIER, positive = LATER. Default -120.
# If captions still lag the voice, try -250; if they run ahead, try 0.
CAPTION_OFFSET_MS=

# --- Output shape ---
TARGET_SHORTS=10
MIN_CLIP_SECONDS=18
MAX_CLIP_SECONDS=60
DEFAULT_CLIP_SECONDS=30

# --- CORS ---
# Comma-separated production origins (Firebase Hosting URL, custom domain...).
# localhost/127.0.0.1 on any port is ALWAYS allowed for local development.
ALLOWED_ORIGINS=
# ALLOWED_ORIGINS=https://your-app.web.app,https://your-app.firebaseapp.com

# --- Uploads / security ---
MAX_UPLOAD_MB=2048
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm,.avi,.m4v

# --- YouTube ---
YOUTUBE_MAX_DURATION=10800        # seconds (3 hours)
YOUTUBE_DOWNLOAD_TIMEOUT=1200
YT_DLP_FORMAT=bestvideo[height<=1080]+bestaudio/best[height<=1080]/best

# --- Storage backend ---
STORAGE_BACKEND=local             # local | gcs
GCS_BUCKET=

# --- Directories (usually leave default) ---
# UPLOAD_DIR=uploads
# OUTPUT_DIR=outputs
